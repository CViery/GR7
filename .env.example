# Copie para .env ou configure estas variáveis no serviço de hospedagem.
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DB_CONNECTION_STRING="Driver={ODBC Driver 18 for SQL Server};Server=tcp:SERVIDOR,1433;Database=BANCO;Uid=USUARIO;Pwd=SENHA;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;"
# Opcional: use somente se Módulos precisar de outro SQL Server.
# Sem esta variável, Módulos reutiliza DB_CONNECTION_STRING automaticamente.
# MODULOS_DATABASE_URI=mssql+pyodbc:///?odbc_connect=STRING_ODBC_CODIFICADA
# Importe os JSONs automaticamente somente em uma base vazia e controlada.
MODULOS_AUTO_SEED=0
# Notificação por e-mail das solicitações de edição (opcional).
PUBLIC_BASE_URL=https://seu-dominio.exemplo
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_TLS=1
SMTP_USER=usuario-smtp
SMTP_PASSWORD=senha-smtp
SMTP_FROM=gr7@empresa.com.br
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
PORT=5000
SESSION_COOKIE_SECURE=1
